{
  "manifest_version": 3,
  "name": "Armarinho Aurora - WhatsApp Tools",
  "version": "1.0.0",
  "description": "Botões de atalho para Pedidos, Calcular Envio e Etiquetas",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://painel.armarinhoaurora.com.br/*",
    "https://nominatim.openstreetmap.org/*",
    "https://cep.awesomeapi.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://painel.armarinhoaurora.com.br/*"],
      "js": ["content-painel.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Armarinho Aurora - WhatsApp Tools",
    "default_popup": "options.html"
  }
}
