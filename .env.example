# ─────────────────────────────────────────────────────────────
# Armarinho Aurora — variáveis de ambiente
# Copie para .env e ajuste. NUNCA versione o .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Banco de dados ───────────────────────────────────────────
DATABASE_URL="postgresql://aurora:aurora@localhost:5432/aurora?schema=public"

# ── API ──────────────────────────────────────────────────────
API_PORT=3333
API_URL="http://localhost:3333"
# Base pública da vitrine — entra nos links dentro dos e-mails e do pedido.
SITE_URL="http://localhost:3000"
API_PREFIX="api"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ── Autenticação ─────────────────────────────────────────────
# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET="troque-em-producao-access"
JWT_REFRESH_SECRET="troque-em-producao-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── Primeiro usuário do painel (usado só pelo `pnpm db:seed`) ─
# Sem ADMIN_PASSWORD, o seed sorteia uma senha e mostra no terminal.
# Nunca existe senha padrão fixa.
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@exemplo.com"
# ADMIN_PASSWORD=""

# ── Front-ends ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3333/api"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
VITE_API_URL="http://localhost:3333/api"
# Usado pelo painel para montar o link da página pública do pedido.
VITE_SITE_URL="http://localhost:3000"

# ── Armazenamento de mídia (S3-compatível: MinIO local / R2 em produção) ──
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="aurora"
S3_ACCESS_KEY_ID="aurora"
S3_SECRET_ACCESS_KEY="aurora"
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL="http://localhost:9000/aurora"

# ── E-mail transacional ──────────────────────────────────────
# Em desenvolvimento usamos o Mailpit local (nenhum e-mail sai da máquina).
# "log" não envia nada: escreve a mensagem no log do serviço. É o padrão
# enquanto a loja não tem e-mail oficial nem SMTP.
MAIL_TRANSPORT="log"
MAIL_HOST="localhost"
MAIL_PORT=1025
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="Armarinho Aurora <nao-responda@armarinhoaurora.com.br>"

# Fora de produção, TODO e-mail é redirecionado para este endereço.
# Nenhuma mensagem chega a cliente real em dev/staging.
MAIL_CATCH_ALL="admin@exemplo.com"

# Para onde vai o aviso de pedido novo. Vazio desliga a notificação.
MAIL_TEAM=""

# ── Loja ─────────────────────────────────────────────────────
STORE_WHATSAPP="5511999990000"
STORE_NAME="Armarinho Aurora"

# Atacado: as tabelas de preço por grupo existem e são editáveis no painel,
# mas nada de atacado aparece na vitrine enquanto isto for "false" (v1).
WHOLESALE_ENABLED="false"

# Teto de pedidos por IP a cada hora. Sem pagamento no site, criar pedido não
# custa nada para quem quiser encher o painel de lixo.
ORDER_RATE_LIMIT_PER_HOUR=10

# ── Observabilidade (opcional em dev) ────────────────────────
SENTRY_DSN=""
LOG_LEVEL="debug"
