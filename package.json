{
  "name": "ecommerce-armarinho-aurora",
  "version": "0.1.0",
  "private": true,
  "description": "E-commerce de catálogo com checkout via WhatsApp — Armarinho Aurora",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "deploy": "bash infra/deploy.sh",
    "deploy:status": "bash infra/deploy.sh status",
    "marca": "node scripts/prepara-marca.mjs",
    "db:migrate": "pnpm --filter @aurora/api run db:migrate",
    "db:seed": "pnpm --filter @aurora/api run db:seed",
    "db:studio": "pnpm --filter @aurora/api run db:studio",
    "db:reset": "pnpm --filter @aurora/api run db:reset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.0.1",
    "sharp": "0.33.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
