[Unit]
Description=Armarinho Aurora - API (homologacao)
Documentation=https://armarinhoaurora.com.br
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/aurora-homolog/apps/api
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5

# Este servidor e compartilhado com seis sites em producao.
# O teto de memoria e a prioridade baixa garantem que a loja em homologacao
# nunca derrube os vizinhos: se estourar, o OOM mata este servico e so ele.
MemoryMax=400M
MemoryHigh=320M
Nice=10
CPUWeight=50

Environment=NODE_ENV=production

StandardOutput=append:/var/log/aurora-api.log
StandardError=append:/var/log/aurora-api.log

# Endurecimento basico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
